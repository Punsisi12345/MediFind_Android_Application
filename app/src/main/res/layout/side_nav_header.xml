<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/layout_corner_round"
    android:layout_margin="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/header_profile_pic"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_person_24"
        android:background="#E0E0E0"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/header_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Guest User"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/header_profile_pic"
        app:layout_constraintEnd_toStartOf="@id/icon_notification"
        app:layout_constraintTop_toTopOf="@id/header_profile_pic"
        app:layout_constraintBottom_toTopOf="@id/header_user_email"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/header_user_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Please log in"
        android:textSize="14sp"
        android:textColor="#757575"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/header_user_name"
        app:layout_constraintEnd_toEndOf="@id/header_user_name"
        app:layout_constraintTop_toBottomOf="@id/header_user_name"
        app:layout_constraintBottom_toTopOf="@id/header_user_role" />

    <TextView
        android:id="@+id/header_user_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Role: User"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onPrimary"
        android:background="@drawable/layout_corner_round"
        android:backgroundTint="@color/md_theme_onPrimaryContainer"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@id/header_user_name"
        app:layout_constraintTop_toBottomOf="@id/header_user_email"
        app:layout_constraintBottom_toBottomOf="@id/header_profile_pic" />

    <ImageView
        android:id="@+id/icon_notification"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="8dp"
        android:src="@drawable/baseline_circle_notifications_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/badge_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/badge_dot"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/icon_notification"
        app:layout_constraintEnd_toEndOf="@id/icon_notification" />

</androidx.constraintlayout.widget.ConstraintLayout>